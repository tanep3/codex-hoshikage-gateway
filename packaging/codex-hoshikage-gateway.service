[Unit]
Description=Codex Hoshikage Discord Gateway
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
Type=simple
# If Cargo installs elsewhere (for example ~/bin), edit the binary path.
ExecStart=%h/.cargo/bin/codex-hoshikage-gateway --config %h/.config/codex-hoshikage-gateway/config.toml direct run
Restart=on-failure
RestartSec=5
TimeoutStopSec=30
KillMode=control-group
UMask=0077
NoNewPrivileges=true

[Install]
WantedBy=default.target
